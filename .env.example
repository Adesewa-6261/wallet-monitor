# Copy to .env.local and fill in. .env.local is gitignored.

# Bitnob — app.bitnob.com → Settings → API Keys
# Note: key creation requires an IP whitelist and expiry date.
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=

# CoinGecko — used only for ETH and TRX, which Bitnob does not price
COINGECKO_API_KEY=

# Postgres connection string
DATABASE_URL=

# Signs login tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Telegram bot token, from @BotFather. The poller records transactions without
# it; alerts simply are not delivered until it is set.
TELEGRAM_BOT_TOKEN=
# Shared between this API and the Telegram bot. The bot presents it as an
# X-Bot-Secret header to reach endpoints no user token can, such as minting a
# session for an already-linked chat. Generate it the same way as JWT_SECRET,
# and set the identical value on both services or the bot cannot call in.
BOT_SHARED_SECRET=

# Alchemy — NFT lookups, which Bitnob does not serve. Ethereum has no method
# for "list the NFTs this address owns", so it needs a provider that indexes
# them. Enable Ethereum and Base mainnet on the app; other networks do nothing
# until the backend supports those chains.
ALCHEMY_API_KEY=
# Optional
# ALERT_POLL_MINUTES=2
# BITCOIN_GAP_LIMIT=20
